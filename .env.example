NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_TIMEOUT_MS=30000
NEXT_PUBLIC_API_DEBUG=false
# Set to false to skip GET /health on the landing page when the Pleco API is not running
# NEXT_PUBLIC_ENABLE_HEALTH_CHECK=false
NEXT_PUBLIC_ENABLE_HEALTH_CHECK=true

NEXT_PUBLIC_SOCIAL_ACTIVE_PROVIDERS=
NEXT_PUBLIC_SOCIAL_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_SOCIAL_FACEBOOK_CLIENT_ID=

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

NEXT_PUBLIC_BASE_DOMAIN=webjoz.com

# === MIDTRANS (required for payment/upgrade) ===
# Sandbox keys have SB- prefix; production keys have no prefix.
# Get both from Midtrans Dashboard → Settings → Access Keys.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_MERCHANT_ID=
# Set to "sandbox" or "production"
NEXT_PUBLIC_MIDTRANS_ENV=sandbox

# === PAYPAL (optional — set NEXT_PUBLIC_PAYPAL_ENABLED=true to enable) ===
NEXT_PUBLIC_PAYPAL_ENABLED=false
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# === SUPPORT WIDGET (optional) ===
# WhatsApp CS floating chat number (format: 628xxx)
NEXT_PUBLIC_WHATSAPP_CS_NUMBER=
# Crisp live chat — leave empty to use WhatsApp button
# NEXT_PUBLIC_CRISP_WEBSITE_ID=
